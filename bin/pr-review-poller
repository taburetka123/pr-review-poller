#!/usr/bin/env bash
# Unattended PR auto-review. Subcommands: status | start | stop | run | logs | config | help.
# Invoked by launchd as `pr-review-poller run` every N seconds.
set -euo pipefail

CONFIG_FILE="${PR_REVIEW_POLLER_CONFIG:-$HOME/.config/pr-review-poller/config.env}"
PLIST_DST="$HOME/Library/LaunchAgents/com.kezoo.pr-review-poller.plist"
LABEL="com.kezoo.pr-review-poller"
STATE_DIR="${PR_REVIEW_POLLER_STATE_DIR:-$HOME/.local/state/pr-review-poller}"
LOCK_FILE="${PR_REVIEW_POLLER_LOCK_FILE:-$HOME/.local/state/pr-review-poller.lock}"
LAST_RUN_FILE="$STATE_DIR/last-run.epoch"
LAST_PRUNE_FILE="$STATE_DIR/last-prune.epoch"
LEDGER_FILE="$STATE_DIR/held.json"
STDOUT_LOG="$HOME/worktrees/.pr-review-poller-stdout.log"
STDERR_LOG="$HOME/worktrees/.pr-review-poller-stderr.log"
FINDINGS_DIR="${PR_REVIEW_FINDINGS_ROOT:-$HOME/worktrees/.pr-review-findings}"
CLAUDE="${PR_REVIEW_POLLER_CLAUDE:-/Users/kezoo/.local/bin/claude}"
RUN_ALL_SCRIPT="${PR_REVIEW_RUN_ALL:-$HOME/.claude/scripts/pr-review-run-all}"
WORKTREE_SCRIPT="${PR_REVIEW_WORKTREE_SCRIPT:-$HOME/.claude/scripts/pr-review-worktree}"

load_config() {
  if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
  fi
  MIN_COMMIT_AGE="${MIN_COMMIT_AGE:-40m}"
  REVIEW_FREQUENCY="${REVIEW_FREQUENCY:-2h}"
  INFLIGHT_TTL="${INFLIGHT_TTL:-1h}"
  # Domain policy. The allowed repo set is DERIVED per tick from code
  # ownership (see derive_owned_repos) — there is no repo list to maintain
  # here, deliberately: a frozen list rots the day a `-co` membership changes.
  # ALLOWED_EXTRA_REPOS is the one additive override, for repos with no `-co`
  # team that are nevertheless reviewed: services-contracts is the live case
  # (no `<repo>-co` team exists for it, yet it carries real review requests).
  # |-separated; config.env overrides it with a one-line edit.
  ALLOWED_EXTRA_REPOS="${ALLOWED_EXTRA_REPOS:-services-contracts}"
}

# Pretty-print whichever scheduling key the plist uses. StartCalendarInterval
# catches up on wake (one coalesced run); StartInterval does not.
plist_schedule() {
  local plist="$1"
  local interval cal
  if interval=$(plutil -extract StartInterval raw "$plist" 2>/dev/null); then
    echo "every ${interval}s (StartInterval — no catch-up after sleep)"
    return
  fi
  if cal=$(plutil -extract StartCalendarInterval json -o - "$plist" 2>/dev/null); then
    local minute hour
    minute=$(echo "$cal" | jq -r '.Minute // "*"' 2>/dev/null)
    hour=$(echo "$cal" | jq -r '.Hour // "*"' 2>/dev/null)
    echo "calendar: hour=$hour minute=$minute (catches up on wake)"
    return
  fi
  echo "unknown (no StartInterval or StartCalendarInterval)"
}

cmd_help() {
  cat <<EOF
pr-review-poller — unattended PR auto-review

Usage:
  pr-review-poller [status]          Show timer state, config, last run
  pr-review-poller start             Load the launchd job (begin polling)
  pr-review-poller start [--post] [--min-commit-age DUR] [--frequency DUR]
                                     Start with flags baked into the plist's
                                     job args so every tick uses them
  pr-review-poller stop              Unload the launchd job (pause polling)
  pr-review-poller run [--head]      Run one review cycle now
                                     --head opens an iTerm2 tab running the
                                     LEGACY in-session flow (claude launches
                                     the reviewers itself): it does NOT
                                     reproduce a production tick — no
                                     poller-side reviewer launch, no in-flight
                                     pre-write, no findings assertion — and
                                     >10-min reviews still die at the harness
                                     600s ceiling. Debug of the skill only
  pr-review-poller run --min-commit-age DUR
                                     Override the commit-age gate for this run
  pr-review-poller run --frequency DUR
                                     Override the run-frequency gate (min gap
                                     between launchd ticks that do work)
  pr-review-poller run --force       Bypass the frequency gate for this run
  pr-review-poller run --verify      VERIFICATION MODE (implies --force): a
                                     complete, honest tick — discovery,
                                     filters, real reviewers, triage, findings
                                     log, freshness assertion, exit codes —
                                     with NO GitHub write on any gh / git /
                                     MCP path: no MCP servers in the claude
                                     sessions, a default-deny gh guard that
                                     also denies the whole 'gh auth' branch
                                     (no credential handout), push-blocked
                                     git/ssh. Blocked attempts are logged
                                     loudly. NOT airtight — raw HTTP clients
                                     (curl/python3/node/perl) cannot be
                                     allowlisted away, and the account-routing
                                     gh wrapper called by absolute path reads
                                     the macOS keyring. This is still the ONLY
                                     mode E2E / verification runs use; a
                                     posting run is a human decision, never a
                                     verification default. The findings log
                                     records the INTENDED action (e.g.
                                     APPROVE) — nothing lands on GitHub;
                                     ledger entries persist as usual
                                     (clear-hold to reset)
  pr-review-poller run --post        Allow posting for this run. Default is
                                     no-post: POST decisions become HOLD;
                                     APPROVE still approves. Incompatible
                                     with --verify
  pr-review-poller logs [-n N]       Tail the stdout log (follow mode)
  pr-review-poller findings          List recent PR-findings logs (mtime sort)
  pr-review-poller findings <pr>     Print findings log for a PR. <pr> is a
                                     full URL (https://github.com/o/r/pull/N)
                                     or a bare number (must be unique across
                                     repos)
  pr-review-poller clear-hold <pr>   Remove a PR's held-ledger entry so the
                                     next tick re-reviews it. <pr> is a URL
                                     or bare number
  pr-review-poller prune             Delete findings logs for PRs that are no
                                     longer OPEN (MERGED or CLOSED). Runs
                                     automatically once/24h during 'run'
  pr-review-poller config            Print current config
  pr-review-poller help              This help

Config:    $CONFIG_FILE
Plist:     $PLIST_DST
Logs:      $STDOUT_LOG
           $STDERR_LOG
Findings:  $FINDINGS_DIR/<owner>/<repo>/<number>.log
See: \$HOME/projects/personal/pr-review-poller/README.md
EOF
}

cmd_status() {
  load_config
  echo "=== pr-review-poller status ==="

  if [[ -f "$PLIST_DST" ]]; then
    SCHEDULE=$(plist_schedule "$PLIST_DST")
    JOB_ARGS=$(plutil -extract ProgramArguments json -o - "$PLIST_DST" 2>/dev/null | \
      jq -r '.[1:] | join(" ")' 2>/dev/null || echo "run")
    echo "plist:            $PLIST_DST"
    echo "  schedule:       $SCHEDULE"
    echo "  job args:       $JOB_ARGS"
  else
    echo "plist:            MISSING — run install.sh to create"
  fi

  if launchctl list | awk '{print $3}' | grep -qx "$LABEL"; then
    INFO=$(launchctl print "gui/$(id -u)/$LABEL" 2>&1)
    STATE=$(echo "$INFO" | awk -F'= ' '/^\tstate / {print $2; exit}')
    LAST_EXIT=$(echo "$INFO" | awk -F'= ' '/^\tlast exit code / {print $2; exit}')
    echo "launchd:          loaded (state: ${STATE:-?}, last exit: ${LAST_EXIT:-?})"
  else
    echo "launchd:          not loaded (run 'pr-review-poller start')"
  fi

  if [[ -f "$LOCK_FILE" ]]; then
    HOLDER_PID=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
    if [[ -n "$HOLDER_PID" ]] && kill -0 "$HOLDER_PID" 2>/dev/null; then
      echo "lock:             held by pid $HOLDER_PID (run in progress)"
    else
      echo "lock:             stale (pid ${HOLDER_PID:-?} no longer running)"
    fi
  else
    echo "lock:             free"
  fi

  echo "config:           $CONFIG_FILE"
  echo "  MIN_COMMIT_AGE:   $MIN_COMMIT_AGE"
  echo "  REVIEW_FREQUENCY: $REVIEW_FREQUENCY"
  echo "  INFLIGHT_TTL:     $INFLIGHT_TTL"

  if [[ -f "$LAST_RUN_FILE" ]]; then
    LAST_EPOCH=$(cat "$LAST_RUN_FILE" 2>/dev/null || echo 0)
    NOW_EPOCH=$(date +%s)
    ELAPSED=$(( NOW_EPOCH - LAST_EPOCH ))
    LAST_HUMAN=$(date -r "$LAST_EPOCH" -Iseconds 2>/dev/null || echo "?")
    echo "last run:         $LAST_HUMAN (${ELAPSED}s ago)"
  else
    echo "last run:         never (or last-run file missing)"
  fi

  if [[ -f "$STDOUT_LOG" ]]; then
    LAST=$(grep -E '^\[.*\] (poll start|poll done|previous run)' "$STDOUT_LOG" 2>/dev/null | tail -1 || echo "")
    [[ -n "$LAST" ]] && echo "last log entry:   $LAST"
  fi

  HELD="$LEDGER_FILE"
  if [[ -f "$HELD" ]] && [[ $(jq 'length' "$HELD" 2>/dev/null || echo 0) -gt 0 ]]; then
    echo
    echo "held (waiting for human review):"
    jq -r 'to_entries[] | "  \(.key)\n    commit \(.value.commit[:7]), held \(.value.held_at)\n    \(.value.reason)\n    \(.value.pr_url)"' "$HELD"
  fi
}

cmd_start() {
  if [[ ! -f "$PLIST_DST" ]]; then
    echo "plist missing at $PLIST_DST — run install.sh first" >&2
    exit 1
  fi

  # Flags here rewrite the plist's ProgramArguments so every launchd tick runs
  # `pr-review-poller run <flags>`. Without flags, the existing plist is left
  # alone (so `start` after a prior `start --post` preserves posting mode).
  local POST_FLAG=0 MIN_AGE_FLAG="" FREQ_FLAG="" had_flag=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --post) POST_FLAG=1; had_flag=1; shift ;;
      --min-commit-age) MIN_AGE_FLAG="$2"; had_flag=1; shift 2 ;;
      --frequency) FREQ_FLAG="$2"; had_flag=1; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 2 ;;
    esac
  done

  if [[ "$had_flag" == "1" ]]; then
    local args_json="[\"$HOME/.local/bin/pr-review-poller\",\"run\""
    [[ -n "$MIN_AGE_FLAG" ]] && args_json="$args_json,\"--min-commit-age\",\"$MIN_AGE_FLAG\""
    [[ -n "$FREQ_FLAG" ]]    && args_json="$args_json,\"--frequency\",\"$FREQ_FLAG\""
    [[ "$POST_FLAG" == "1" ]] && args_json="$args_json,\"--post\""
    args_json="$args_json]"
    plutil -replace ProgramArguments -json "$args_json" "$PLIST_DST"
  fi

  launchctl unload "$PLIST_DST" 2>/dev/null || true
  launchctl load "$PLIST_DST"
  SCHEDULE=$(plist_schedule "$PLIST_DST")
  JOB_ARGS=$(plutil -extract ProgramArguments json -o - "$PLIST_DST" 2>/dev/null | \
    jq -r '.[1:] | join(" ")' 2>/dev/null || echo "run")
  echo "started (schedule: $SCHEDULE, job args: $JOB_ARGS)."
}

cmd_stop() {
  launchctl unload "$PLIST_DST" 2>/dev/null || true
  echo "stopped"
}

# Walk $FINDINGS_DIR and delete log files whose PR is no longer OPEN (MERGED or
# CLOSED). Gated to once/24h via $LAST_PRUNE_FILE unless force=1 is passed.
# Caller must have GH_TOKEN exported (gh auth) and a usable cwd for gh.
prune_findings() {
  local force="${1:-0}"
  local prune_seconds=86400
  if [[ "$force" != "1" && -f "$LAST_PRUNE_FILE" ]]; then
    local last elapsed
    last=$(cat "$LAST_PRUNE_FILE" 2>/dev/null || echo 0)
    elapsed=$(( $(date +%s) - last ))
    if [[ "$elapsed" -lt "$prune_seconds" ]]; then
      return 0
    fi
  fi
  if [[ ! -d "$FINDINGS_DIR" ]]; then
    return 0
  fi

  local deleted=0 kept=0 errors=0
  while IFS= read -r f; do
    local pr repo state
    pr=$(basename "$f" .log)
    repo=${f#"$FINDINGS_DIR/"}
    repo=${repo%"/$pr.log"}
    if state=$(gh pr view "$pr" -R "$repo" --json state -q .state 2>/dev/null); then
      case "$state" in
        MERGED|CLOSED)
          echo "  prune: rm $repo#$pr ($state)"
          rm -f "$f"
          deleted=$((deleted+1))
          ;;
        *)
          kept=$((kept+1))
          ;;
      esac
    else
      errors=$((errors+1))
    fi
  done < <(find "$FINDINGS_DIR" -name '*.log' -type f)

  find "$FINDINGS_DIR" -mindepth 2 -type d -empty -delete 2>/dev/null || true

  mkdir -p "$(dirname "$LAST_PRUNE_FILE")"
  date +%s > "$LAST_PRUNE_FILE"
  echo "[$(date -Iseconds)] prune: deleted=$deleted, kept=$kept, gh-errors=$errors"
}

cmd_prune() {
  load_config
  WORK_CWD="${PR_REVIEW_POLLER_WORK_CWD:-$HOME/projects/work/otto-service-requests-service}"
  if ! cd "$WORK_CWD" 2>/dev/null; then
    echo "work cwd missing ($WORK_CWD)" >&2
    exit 1
  fi
  WORK_GH_USER="${PR_REVIEW_POLLER_GH_USER:-aleksandr-beliakov-rs}"
  if ! GH_TOKEN=$(gh auth token --user "$WORK_GH_USER" -h github.com 2>&1); then
    echo "could not get gh token for $WORK_GH_USER: $GH_TOKEN" >&2
    exit 1
  fi
  export GH_TOKEN
  prune_findings 1
}

duration_to_seconds() {
  case "$1" in
    0)  echo 0 ;;
    *m) echo $(( ${1%m} * 60 )) ;;
    *h) echo $(( ${1%h} * 3600 )) ;;
    *)  return 1 ;;
  esac
}

# Parse an ISO8601 timestamp as written by `date -Iseconds` (e.g.
# 2026-06-25T12:19:10+07:00, or a Z form) to epoch seconds. BSD `date -j -f`
# with %z rejects the colon in a +HH:MM offset and the bare `Z`, so normalise
# Z -> +0000 and strip the colon from a trailing +HH:MM / -HH:MM offset first.
# The offset embedded in the timestamp is authoritative — do NOT force TZ here.
# Returns non-zero (and prints nothing) on an unparseable timestamp.
iso8601_to_epoch() {
  local ts="$1"
  [[ -z "$ts" ]] && return 1
  ts="${ts/Z/+0000}"
  if [[ "$ts" =~ ^(.+)([+-][0-9]{2}):([0-9]{2})$ ]]; then
    ts="${BASH_REMATCH[1]}${BASH_REMATCH[2]}${BASH_REMATCH[3]}"
  fi
  date -j -f "%Y-%m-%dT%H:%M:%S%z" "$ts" +%s 2>/dev/null
}

# Remove abandoned "[in-flight]" placeholders from the held ledger. A placeholder
# is abandoned when its held_at is older than $3 seconds (or missing/unparseable).
# Real holds (any reason NOT starting with "[in-flight]") are never touched.
# Called from cmd_run after the PID lock is held, so any surviving placeholder is
# necessarily orphaned from a dead run (see the lock in cmd_run); the TTL is the
# cooldown and a floor against the lock's check-then-write race. Pure: no gh/net.
prune_inflight_holds() {
  local ledger="$1" now_epoch="$2" ttl_seconds="$3"
  [[ -f "$ledger" ]] || return 0

  local expired_keys=() key held_at held_epoch age
  while IFS=$'\t' read -r key held_at; do
    [[ -z "$key" ]] && continue
    if held_epoch=$(iso8601_to_epoch "$held_at"); then
      age=$(( now_epoch - held_epoch ))
      [[ "$age" -ge "$ttl_seconds" ]] && expired_keys+=("$key")
    else
      # Missing/unparseable held_at: a malformed placeholder must not be able to
      # stick forever (that is the bug being fixed) — treat it as expired.
      expired_keys+=("$key")
    fi
  done < <(jq -r '
    to_entries[]
    | select(.value.reason | type == "string" and startswith("[in-flight]"))
    | [.key, (.value.held_at // "")]
    | @tsv' "$ledger" 2>/dev/null)

  [[ ${#expired_keys[@]} -eq 0 ]] && return 0

  local keys_json tmp
  keys_json=$(printf '%s\n' "${expired_keys[@]}" | jq -R . | jq -s 'map([.])')
  tmp=$(mktemp)
  if jq --argjson drop "$keys_json" 'delpaths($drop)' "$ledger" > "$tmp"; then
    mv "$tmp" "$ledger"
    for key in "${expired_keys[@]}"; do
      echo "  prune in-flight: $key (placeholder older than ${ttl_seconds}s, orphaned from a dead run — eligible for re-review)"
    done
  else
    rm -f "$tmp"
    echo "  prune in-flight: jq delete failed, ledger left unchanged" >&2
    return 1
  fi
}

# --verify support: a guard toolchain that blocks GitHub writes on every
# gh / git / MCP path for the tick subtree. It is NOT airtight, and the
# accurate claim matters more than a strong-sounding one (an earlier revision
# said "structurally impossible"; a reviewer punctured it in twenty minutes):
#   1. MCP: the triage and reviewer claude sessions run with
#      --strict-mcp-config --mcp-config '{"mcpServers":{}}' — no MCP server is
#      loaded at all, so mcp__github__* / slack write tools do not exist
#      (harness-enforced, not a model instruction).
#   2. gh: a PATH-priority default-deny guard (read-only shapes only) fronts
#      every gh call and logs denials. The ENTIRE `gh auth` branch is denied:
#      a handed-out token defeats everything downstream, so the credential is
#      the real control point. GH_TOKEN is never exported in this mode.
#   3. git: a PATH guard denies push/send-pack, and GIT_SSH_COMMAND routes
#      through a wrapper that refuses any remote git-receive-pack — so a push
#      is blocked even via an absolute-path git.
# NAMED RESIDUALS (do not paper over these):
#   (a) Raw HTTP clients — curl, python3, node, perl — cannot be allowlisted
#       away; chasing them is whack-a-mole. Any credential obtained by other
#       means still reaches api.github.com. Denying `gh auth` removes the
#       easy handout, not the possibility.
#   (b) The account-routing gh wrapper (~/projects/personal/bin-scripts/gh,
#       which is what `gh` resolves to here) invoked by ABSOLUTE path skips
#       this PATH guard, and its lookup reads the macOS KEYRING — which
#       GH_CONFIG_DIR does not gate. The empty GH_CONFIG_DIR below still
#       de-authenticates the plain homebrew binary, so it is kept as
#       defence-in-depth, but it is NOT a deauthentication guarantee.
#   (c) The Keychain directly: `security find-generic-password -s
#       "gh:github.com" -w` returns the token in ONE command, touching no gh,
#       no git and no MCP. This is the shortest route of the three and the
#       reason (a) is not hypothetical — name it explicitly, never fold it
#       into (a)'s "obtained by other means".
VERIFY_GUARD_DIR=""
VERIFY_GUARD_LOG=""
setup_verify_guard() {
  VERIFY_GUARD_DIR=$(mktemp -d)
  VERIFY_GUARD_LOG="$VERIFY_GUARD_DIR/blocked.log"
  : > "$VERIFY_GUARD_LOG"
  mkdir -p "$VERIFY_GUARD_DIR/gh-config-empty"
  local real_gh real_git real_cfg
  real_gh=$(command -v gh)
  real_git=$(command -v git)
  real_cfg="${GH_CONFIG_DIR:-$HOME/.config/gh}"

  cat > "$VERIFY_GUARD_DIR/gh" <<GH_EOF
#!/bin/bash
# generated by pr-review-poller --verify: default-deny GitHub guard
REAL_GH="$real_gh"
REAL_CFG="$real_cfg"
LOG="$VERIFY_GUARD_LOG"
GH_EOF
  cat >> "$VERIFY_GUARD_DIR/gh" <<'GH_EOF'
deny() {
  echo "BLOCKED gh $*" >> "$LOG"
  echo "pr-review-poller --verify: BLOCKED GitHub write attempt: gh $*" >&2
  exit 86
}
case "${1:-}" in
  # The ENTIRE auth branch is denied — a handed-out token is the whole ball
  # game: curl/python3/node/perl all speak HTTP and none can be allowlisted
  # away, so the credential itself is the only control point that works.
  # (`auth status --show-token` printed it too; inspecting $2 alone was not
  # enough.) The poller's own liveness check runs BEFORE this guard is on PATH.
  auth) deny "$@" ;;
  search) ;;
  pr)
    case "${2:-}" in view|diff|checks|list) ;; *) deny "$@" ;; esac ;;
  repo)
    case "${2:-}" in view) ;; *) deny "$@" ;; esac ;;
  api)
    method="" ; fields=0 ; grab=0
    for a in "$@"; do
      if [ "$grab" = "1" ]; then method="$a"; grab=0; continue; fi
      case "$a" in
        -X|--method) grab=1 ;;
        -X*) method="${a#-X}" ;;
        --method=*) method="${a#--method=}" ;;
        -f|-F|--field|--raw-field|--input|-f*|-F*|--field=*|--raw-field=*|--input=*) fields=1 ;;
      esac
    done
    up=$(printf '%s' "$method" | tr '[:lower:]' '[:upper:]')
    if [ -n "$up" ] && [ "$up" != "GET" ]; then deny "$@"; fi
    if [ "$fields" = "1" ] && [ "$up" != "GET" ]; then deny "$@"; fi
    ;;
  help|--help|version|--version|"") ;;
  *) deny "$@" ;;
esac
GH_CONFIG_DIR="$REAL_CFG" exec "$REAL_GH" "$@"
GH_EOF

  cat > "$VERIFY_GUARD_DIR/git" <<GIT_EOF
#!/bin/bash
# generated by pr-review-poller --verify: push-blocking git guard
REAL_GIT="$real_git"
LOG="$VERIFY_GUARD_LOG"
GIT_EOF
  cat >> "$VERIFY_GUARD_DIR/git" <<'GIT_EOF'
for a in "$@"; do
  case "$a" in
    push|send-pack)
      echo "BLOCKED git $*" >> "$LOG"
      echo "pr-review-poller --verify: BLOCKED git push attempt: git $*" >&2
      exit 86
      ;;
  esac
done
exec "$REAL_GIT" "$@"
GIT_EOF

  cat > "$VERIFY_GUARD_DIR/verify-ssh" <<SSH_EOF
#!/bin/bash
# generated by pr-review-poller --verify: GIT_SSH_COMMAND wrapper — a git push
# runs git-receive-pack on the remote; refuse it, allow fetch (git-upload-pack).
LOG="$VERIFY_GUARD_LOG"
SSH_EOF
  cat >> "$VERIFY_GUARD_DIR/verify-ssh" <<'SSH_EOF'
for a in "$@"; do
  case "$a" in
    *git-receive-pack*)
      echo "BLOCKED ssh $*" >> "$LOG"
      echo "pr-review-poller --verify: BLOCKED ssh git-receive-pack (push)" >&2
      exit 86
      ;;
  esac
done
exec /usr/bin/ssh "$@"
SSH_EOF

  chmod +x "$VERIFY_GUARD_DIR/gh" "$VERIFY_GUARD_DIR/git" "$VERIFY_GUARD_DIR/verify-ssh"
}

# Resolve the freshest code-owner map into OWNED_CSV_FILE. Prefers origin/main
# of the engineering-pods repo (git show works regardless of which branch that
# checkout sits on — it is routinely parked on feature branches); falls back to
# the working-tree copy with a logged warning; leaves the path missing when
# neither resolves, which derive_owned_repos treats as fail-closed.
# PR_REVIEW_OWNED_CSV overrides everything (tests).
OWNED_CSV_FILE=""
resolve_owned_csv() {
  if [[ -n "${PR_REVIEW_OWNED_CSV:-}" ]]; then
    OWNED_CSV_FILE="$PR_REVIEW_OWNED_CSV"
    return 0
  fi
  local pods_repo="$HOME/projects/work/engineering-pods"
  local cache="$STATE_DIR/code-owner-map.csv"
  mkdir -p "$STATE_DIR"
  if git -C "$pods_repo" fetch origin main --quiet 2>/dev/null \
     && git -C "$pods_repo" show origin/main:config/code-owner-team-member.csv > "$cache" 2>/dev/null; then
    OWNED_CSV_FILE="$cache"
    return 0
  fi
  if [[ -f "$pods_repo/config/code-owner-team-member.csv" ]]; then
    echo "[$(date -Iseconds)] WARNING: code-owner-map fetch from origin/main failed — using the on-disk working-tree copy (may be stale)"
    OWNED_CSV_FILE="$pods_repo/config/code-owner-team-member.csv"
    return 0
  fi
  OWNED_CSV_FILE="$cache.missing"
}

# Derive the set of repos this poller may auto-review from the code-owner map:
# every `<repo>-co` team $WORK_GH_USER belongs to IS a repo it reviews, because
# that membership is what generates the review requests in the first place.
#
# Why not the pod columns (the gate this replaces): pod data was wrong in BOTH
# directions for this purpose — repo pod-ownership admitted
# otto-business-process-service ("Otto - Core", the 2026-07-27 incident repo,
# which this login does not own), while pod MEMBERSHIP (team-member.csv) lists
# the engineer under otto-property-services + otto-resident-experience and omits
# otto-leasing outright. Code ownership is the signal that actually drives
# review requests, so it is the one the gate keys on.
#
# Identity: this map's `Member` column holds GITHUB LOGINS (verified: zero rows
# contain "@"), and the poller already knows its own login as $WORK_GH_USER —
# so no login->email bridge is needed. The email form lives only in
# team-member.csv, the pod file this gate no longer reads.
#
# Populates OWNED_REPOS (newline-separated). rc 0 = derived. rc 1 = refuse
# everything this tick, with a DISTINCT reason on stdout per failure arm:
# unavailable map / unparseable shape / a -co-less team name / zero matches.
OWNED_REPOS=""
derive_owned_repos() {
  OWNED_REPOS=""
  if [[ -z "${OWNED_CSV_FILE:-}" || ! -f "$OWNED_CSV_FILE" ]]; then
    echo "code-owner map unavailable (no fetch, no cached or on-disk copy)"
    return 1
  fi
  # Validate the schema before trusting a parse: a silently-changed header must
  # fail loudly, never degrade into "matched nothing" (which reads as "owns
  # nothing" and would mute the loop). An empty file lands here too.
  local header
  header=$(head -1 "$OWNED_CSV_FILE" 2>/dev/null || echo "")
  if [[ "$header" != '"Team","Pod","Member"' ]]; then
    echo "code-owner map has an unexpected header ('${header:-<empty file>}' != '\"Team\",\"Pod\",\"Member\"') — refusing to guess its shape"
    return 1
  fi
  local teams
  teams=$(awk -F'","' -v me="$WORK_GH_USER" '
    NR == 1 { next }
    {
      team = $1; sub(/^"/, "", team)
      member = $3; sub(/"$/, "", member)
      if (member == me) print team
    }' "$OWNED_CSV_FILE")
  if [[ -z "$teams" ]]; then
    # The loudest arm on purpose: indistinguishable from "owns nothing", and a
    # silent mute is the exact failure class this whole repair exists to kill.
    echo "ZERO code-owner teams matched '$WORK_GH_USER' in the code-owner map — refusing every PR this tick. A renamed login or a mangled map looks identical to 'owns nothing'; check the map or set ALLOWED_EXTRA_REPOS"
    return 1
  fi
  local team repo
  while IFS= read -r team; do
    [[ -z "$team" ]] && continue
    if [[ "$team" != *-co ]]; then
      echo "code-owner map has a team name without the -co suffix ('$team') — refusing to guess which repo it means"
      return 1
    fi
    repo="${team%-co}"
    OWNED_REPOS="$OWNED_REPOS$repo"$'\n'
  done <<<"$teams"
  return 0
}

# Domain gate: is <repo> ours to auto-review? rc 0 = allowed (derived ownership
# or the explicit additive override). rc 1 = refused, reason on stdout for the
# caller's skip line. Distinct from the clone check, which is CAPABILITY (can
# this machine review it) rather than domain (should it).
repo_owned() {
  local repo="$1" extra
  IFS='|' read -r -a _extras <<<"${ALLOWED_EXTRA_REPOS:-}"
  for extra in "${_extras[@]:-}"; do
    [[ -n "$extra" && "$extra" == "$repo" ]] && return 0
  done
  local owned
  while IFS= read -r owned; do
    [[ -n "$owned" && "$owned" == "$repo" ]] && return 0
  done <<<"$OWNED_REPOS"
  echo "not a code owner of it ($WORK_GH_USER is not in ${repo}-co) — add the membership upstream, or ALLOWED_EXTRA_REPOS if it should be reviewed anyway"
  return 1
}

# Phase 1 discovery + filtering. Same logic as ~/.claude/skills/kezoo-review-prs/SKILL.md
# Phase 1, pulled into bash so empty/all-skipped ticks don't burn Claude tokens.
# Writes surviving PR URLs into the FILTER_SURVIVORS array (caller reads it).
# Prints "  skip #N: <reason>" log lines to stdout so the poller log captures them.
FILTER_SURVIVORS=()
OWNED_GATE_FAILED=0
filter_prs() {
  FILTER_SURVIVORS=()
  local me="aleksandr-beliakov-rs"
  local ledger="$LEDGER_FILE"
  local now_epoch; now_epoch=$(date +%s)
  local min_seconds; min_seconds=$(duration_to_seconds "$MIN_COMMIT_AGE") || {
    echo "invalid --min-commit-age: $MIN_COMMIT_AGE" >&2
    return 2
  }

  # Mirrors the team-members list in ~/.claude/skills/kezoo-review-prs/SKILL.md.
  # Keep in sync when the skill's team changes.
  local team=(aleksandr-beliakov-rs dmitry-indikeev-rs alejandro-gomez-rs alexander-grigorov-rs vadim-kostenko-rs)

  local raw
  if ! raw=$(gh search prs --review-requested=@me --state=open --draft=false --limit=50 \
      --json number,title,repository,author 2>&1); then
    echo "gh search failed: $raw" >&2
    return 1
  fi
  if [[ -z "$raw" || "$raw" == "[]" ]]; then
    return 0
  fi

  while IFS=$'\t' read -r owner repo number author; do
    [[ -z "$number" ]] && continue

    # 1. Team-author filter
    local in_team=0
    for t in "${team[@]}"; do
      [[ "$t" == "$author" ]] && { in_team=1; break; }
    done
    if [[ "$in_team" == "0" ]]; then
      echo "  skip #$number ($owner/$repo): author $author not on team"
      continue
    fi

    # 2. Repo-cloned check — CAPABILITY: can this machine review it at all.
    if [[ ! -d "$HOME/projects/work/$repo" ]]; then
      echo "  skip #$number ($owner/$repo): ~/projects/work/$repo not cloned"
      continue
    fi

    # 2b. Domain check — SHOULD we: code ownership, distinct from the clone
    # check above (a cloned repo is not necessarily ours; the 2026-07-27
    # incident auto-approved in a repo this login does not own purely because
    # the author was on the team list and the repo happened to be cloned).
    # Distinct message so the log shows WHICH gate fired.
    if [[ "$OWNED_GATE_FAILED" == "1" ]]; then
      echo "  skip #$number ($owner/$repo): domain gate unavailable (see the ERROR above) — fail closed"
      continue
    fi
    local owned_reason
    if ! owned_reason=$(repo_owned "$repo"); then
      echo "  skip #$number ($owner/$repo): domain gate — $owned_reason"
      continue
    fi

    # 3. Single gh pr view for all remaining filters
    local info
    if ! info=$(gh pr view "$number" -R "$owner/$repo" --json state,reviews,commits,headRefName 2>&1); then
      echo "  skip #$number ($owner/$repo): gh pr view failed ($info)"
      continue
    fi

    # 3b. Still-open check. The search result can be stale: a PR merged between
    # the search and this point wastes a reviewer run on a deleted branch
    # (observed 2026-07-27: #190 merged mid-tick, worktree fetch died on the
    # auto-deleted ref). Skip anything that is no longer OPEN.
    local pr_state
    pr_state=$(echo "$info" | jq -r '.state // "OPEN"' 2>/dev/null)
    if [[ "$pr_state" != "OPEN" ]]; then
      echo "  skip #$number ($owner/$repo): state is $pr_state, not OPEN"
      continue
    fi

    local head_oid committed_at
    head_oid=$(echo "$info" | jq -r '.commits[-1].oid' 2>/dev/null)
    committed_at=$(echo "$info" | jq -r '.commits[-1].committedDate' 2>/dev/null)
    if [[ -z "$head_oid" || "$head_oid" == "null" ]]; then
      echo "  skip #$number ($owner/$repo): could not parse HEAD commit"
      continue
    fi

    # 4. Commit-age gate
    local committed_epoch age
    # TZ=UTC is required: BSD `date -j -f` ignores the literal `Z` in the format
    # and parses the timestamp in $TZ, so without it the age is off by the
    # local offset (7h in +07) and every commit looks artificially old — the
    # gate never trips and too-young commits leak through to the auto-claim.
    committed_epoch=$(TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%SZ" "$committed_at" +%s 2>/dev/null)
    if [[ -z "$committed_epoch" ]]; then
      echo "  skip #$number ($owner/$repo): could not parse committedDate $committed_at"
      continue
    fi
    age=$(( now_epoch - committed_epoch ))
    if [[ "$age" -lt "$min_seconds" ]]; then
      echo "  skip #$number ($owner/$repo): newest commit is ${age}s old, below ${min_seconds}s threshold"
      continue
    fi

    # 5. Last-review-commit dedup
    local my_last_oid
    my_last_oid=$(echo "$info" | jq -r --arg me "$me" \
      '[.reviews[] | select(.author.login == $me)] | last | .commit.oid // empty' 2>/dev/null)
    if [[ -n "$my_last_oid" && "$my_last_oid" == "$head_oid" ]]; then
      echo "  skip #$number ($owner/$repo): already reviewed at HEAD ${head_oid:0:7}"
      continue
    fi

    local head_ref
    head_ref=$(echo "$info" | jq -r '.headRefName // empty' 2>/dev/null)
    if [[ -z "$head_ref" ]]; then
      echo "  skip #$number ($owner/$repo): could not parse headRefName"
      continue
    fi

    # 6. Already-approved-by-anyone skip
    local approved
    approved=$(echo "$info" | jq '[.reviews | group_by(.author.login)[] | max_by(.submittedAt) | select(.state == "APPROVED")] | length > 0' 2>/dev/null)
    if [[ "$approved" == "true" ]]; then
      echo "  skip #$number ($owner/$repo): already approved by another reviewer"
      continue
    fi

    # 7. Held-ledger skip. Two flavours of entry:
    #   - real HOLD written by the skill — "pending human review"
    #   - "[in-flight]" placeholder written by cmd_run before invoking claude
    #     so a mid-review crash (rate-limit, etc.) doesn't burn a retry next
    #     tick. User clears via `pr-review-poller clear-hold <pr>`.
    if [[ -f "$ledger" ]]; then
      local held_commit held_reason
      held_commit=$(jq -r --arg key "$owner/$repo#$number" '.[$key].commit // empty' "$ledger" 2>/dev/null)
      held_reason=$(jq -r --arg key "$owner/$repo#$number" '.[$key].reason // empty' "$ledger" 2>/dev/null)
      if [[ "$held_commit" == "$head_oid" ]]; then
        if [[ "$held_reason" == \[in-flight\]* ]]; then
          echo "  skip #$number ($owner/$repo): in-flight entry at HEAD ${head_oid:0:7} (clear-hold to retry)"
        else
          echo "  skip #$number ($owner/$repo): held at HEAD ${head_oid:0:7} pending human review"
        fi
        continue
      fi
    fi

    # Tab-separated tuple so cmd_run can pre-write in-flight ledger entries
    # before invoking claude (needs head_oid, not just URL).
    FILTER_SURVIVORS+=("$owner"$'\t'"$repo"$'\t'"$number"$'\t'"$head_oid"$'\t'"$head_ref"$'\t'"$my_last_oid"$'\t'"https://github.com/$owner/$repo/pull/$number")
  done < <(echo "$raw" | jq -r '.[] | [
      (.repository.nameWithOwner | split("/")[0]),
      (.repository.nameWithOwner | split("/")[1]),
      (.number | tostring),
      .author.login
    ] | @tsv')
}

# One pr-review-run-all spec line per survivor:
#   <repo>\t<pr>\t<branch>\t<owner/repo>\t<since-commit-or-empty>
# Splits by parameter expansion, not `IFS=$'\t' read`: bash classifies tab as
# "IFS whitespace" and collapses consecutive occurrences even when IFS is set
# to tab alone, so `read` silently drops the empty my_last_oid field (position
# 6) and shifts url into it. Parameter-expansion pattern matching is literal
# and does not collapse.
build_review_specs() {
  local survivor rest owner repo number head_oid head_ref my_last url
  for survivor in "$@"; do
    rest="$survivor"
    owner="${rest%%$'\t'*}";    rest="${rest#*$'\t'}"
    repo="${rest%%$'\t'*}";     rest="${rest#*$'\t'}"
    number="${rest%%$'\t'*}";   rest="${rest#*$'\t'}"
    head_oid="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
    head_ref="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
    my_last="${rest%%$'\t'*}";  rest="${rest#*$'\t'}"
    url="$rest"
    printf '%s\t%s\t%s\t%s/%s\t%s\n' "$repo" "$number" "$head_ref" "$owner" "$repo" "$my_last"
  done
}

# Every dispatched PR must have produced a findings log THIS tick (the skill
# appends one for every reviewed PR regardless of action, even zero findings).
# Existence alone is not enough: on a re-review the file already exists from
# the previous round — require mtime >= tick start. One ERROR line per miss;
# returns the miss count so the caller can fail the tick loudly. A tick that
# invoked claude and recorded nothing must never say "poll done" (the 2026-07
# self-kill produced 189 such silent ticks).
assert_findings_fresh() {
  local start_epoch="$1"; shift
  local survivor owner repo number rest missing=0 f mtime ctx
  for survivor in "$@"; do
    IFS=$'\t' read -r owner repo number rest <<<"$survivor"
    f="$FINDINGS_DIR/$owner/$repo/$number.log"
    # Distinguish "reviewer errored" from "triage wrote no findings log": quote
    # the result file's Status: line when it exists (spec-review F1).
    ctx="no result file"
    if [[ -f "${PR_REVIEW_RESULT_DIR:-/tmp/pr-review}/$number.md" ]]; then
      ctx=$(grep -m1 '^Status:' "${PR_REVIEW_RESULT_DIR:-/tmp/pr-review}/$number.md" 2>/dev/null || echo "no Status line")
    fi
    if [[ ! -f "$f" ]]; then
      echo "[$(date -Iseconds)] ERROR: findings log missing for $owner/$repo#$number (expected $f; reviewer: $ctx)"
      missing=$((missing+1))
      continue
    fi
    # A fresh inode is not a record: a zero-byte log means the writer died
    # mid-append (or never wrote) — that must fail exactly like a missing log.
    if [[ ! -s "$f" ]]; then
      echo "[$(date -Iseconds)] ERROR: findings log empty for $owner/$repo#$number ($f is zero bytes; reviewer: $ctx)"
      missing=$((missing+1))
      continue
    fi
    mtime=$(stat -f %m "$f" 2>/dev/null || echo 0)
    if [[ "$mtime" -lt "$start_epoch" ]]; then
      echo "[$(date -Iseconds)] ERROR: findings log stale for $owner/$repo#$number ($f mtime $mtime < tick start $start_epoch; reviewer: $ctx)"
      missing=$((missing+1))
    fi
  done
  # Exit codes wrap mod 256; unreachable at the --limit=50 survivor cap, but
  # clamp so a future cap raise can never wrap missing back down to 0.
  [[ "$missing" -gt 255 ]] && missing=255
  return "$missing"
}

# Best-effort worktree + result-file cleanup for every dispatched survivor.
# Hoisted so every post-launch exit path (run-all failure included) leaves no
# leaked worktree or stale result file for the next tick to trip over.
cleanup_dispatched() {
  local survivor _o _r _n _rest
  for survivor in "$@"; do
    IFS=$'\t' read -r _o _r _n _rest <<<"$survivor"
    "$WORKTREE_SCRIPT" cleanup "$_r" "$_n" >/dev/null 2>&1 || true
    rm -f "$PR_REVIEW_RESULT_DIR/$_n.md"
  done
}

cmd_run() {
  load_config
  MODE="headless"
  POST=0
  FORCE=0
  VERIFY=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --head) MODE="head"; shift ;;
      --min-commit-age) MIN_COMMIT_AGE="$2"; shift 2 ;;
      --frequency) REVIEW_FREQUENCY="$2"; shift 2 ;;
      --post) POST=1; shift ;;
      --force) FORCE=1; shift ;;
      --verify) VERIFY=1; FORCE=1; shift ;;
      *) echo "unknown flag: $1" >&2; exit 2 ;;
    esac
  done
  if [[ "$VERIFY" == "1" && "$POST" == "1" ]]; then
    echo "--verify and --post are mutually exclusive" >&2
    exit 2
  fi
  if [[ "$VERIFY" == "1" && "$MODE" == "head" ]]; then
    echo "--verify does not compose with --head (head mode is the legacy in-session path)" >&2
    exit 2
  fi

  SLASH="/kezoo-review-prs --auto --min-commit-age ${MIN_COMMIT_AGE}"
  [[ "$POST" == "1" ]] && SLASH="$SLASH --post"

  if [[ "$MODE" == "head" ]]; then
    osascript <<OSA
tell application "iTerm"
  activate
  tell current window
    create tab with default profile
    delay 0.6
    tell current session of current tab
      write text "$CLAUDE --model claude-opus-5 -p \"$SLASH\""
    end tell
  end tell
end tell
OSA
    exit 0
  fi

  # PID-file lock (macOS has no flock). Self-heals after crashes via kill -0.
  mkdir -p "$(dirname "$LOCK_FILE")"
  if [[ -f "$LOCK_FILE" ]]; then
    OLD_PID=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
    if [[ -n "$OLD_PID" ]] && kill -0 "$OLD_PID" 2>/dev/null; then
      echo "[$(date -Iseconds)] previous run still active (pid $OLD_PID), skipping"
      exit 0
    fi
  fi
  echo $$ > "$LOCK_FILE"
  trap 'rm -f "$LOCK_FILE"; [[ -n "$VERIFY_GUARD_DIR" ]] && rm -rf "$VERIFY_GUARD_DIR"' EXIT

  # cd to a work repo so any gh subcommand that reads remotes (gh pr view) lines
  # up with the right repo. The active gh account is forced via GH_TOKEN below.
  WORK_CWD="${PR_REVIEW_POLLER_WORK_CWD:-$HOME/projects/work/otto-service-requests-service}"
  if ! cd "$WORK_CWD" 2>/dev/null; then
    echo "[$(date -Iseconds)] work cwd missing ($WORK_CWD), skipping tick"
    exit 0
  fi

  # gh's active account is global, not cwd-scoped — under launchd it resolves to
  # the personal account, so `--review-requested=@me` returns nothing. Pull the
  # work-account token from the keyring and export it for this run only.
  # VERIFY: validate liveness HERE, BEFORE the guard goes on PATH (the guard
  # denies the whole `gh auth` branch), and never export GH_TOKEN — an exported
  # token would hand the credential straight to the session's environment.
  WORK_GH_USER="${PR_REVIEW_POLLER_GH_USER:-aleksandr-beliakov-rs}"
  if [[ "$VERIFY" == "1" ]]; then
    if ! gh auth token --user "$WORK_GH_USER" -h github.com >/dev/null 2>&1; then
      echo "[$(date -Iseconds)] could not validate gh token for $WORK_GH_USER"
      exit 0
    fi
  else
    if ! GH_TOKEN=$(gh auth token --user "$WORK_GH_USER" -h github.com 2>&1); then
      echo "[$(date -Iseconds)] could not get gh token for $WORK_GH_USER: $GH_TOKEN"
      exit 0
    fi
    export GH_TOKEN
  fi

  if [[ "$VERIFY" == "1" ]]; then
    setup_verify_guard
    export PATH="$VERIFY_GUARD_DIR:$PATH"
    export GH_CONFIG_DIR="$VERIFY_GUARD_DIR/gh-config-empty"
    export GIT_SSH_COMMAND="$VERIFY_GUARD_DIR/verify-ssh"
    export PR_REVIEW_NO_MCP=1
    echo "[$(date -Iseconds)] VERIFY MODE: no GitHub write on any gh / git / MCP path this tick (gh guard denies writes AND the whole auth branch — no credential handout; no MCP servers in claude sessions; push-blocked git/ssh). NOT airtight — named residuals: (1) raw HTTP clients (curl/python3/node/perl) cannot be allowlisted away, so a credential obtained by other means still reaches api.github.com; (2) the account-routing gh wrapper invoked by ABSOLUTE path bypasses this guard and reads the macOS keyring, which no env var gates; (3) the Keychain directly — 'security find-generic-password -s gh:github.com -w' returns the token in ONE command, touching no gh, no git, no MCP. Guard log: $VERIFY_GUARD_LOG"
  fi

  echo "[$(date -Iseconds)] poll start (min-commit-age=$MIN_COMMIT_AGE, frequency=$REVIEW_FREQUENCY, post=$POST, verify=$VERIFY, cwd=$WORK_CWD, gh_user=$WORK_GH_USER)"

  # Daily housekeeping: drop findings logs for PRs that are no longer open.
  # Independent of the review frequency gate; runs at most once/24h.
  prune_findings || echo "[$(date -Iseconds)] prune failed (non-fatal)"

  # Frequency gate: launchd fires hourly so a post-sleep wake catches up
  # immediately, but we only do real work once per REVIEW_FREQUENCY window.
  # Stamp on gate-pass (not on claude success) so a claude rate-limit doesn't
  # cause hourly retries — the in-flight ledger already protects per-PR.
  # --force (manual override) bypasses the gate.
  if [[ "$FORCE" != "1" ]]; then
    local freq_seconds; freq_seconds=$(duration_to_seconds "$REVIEW_FREQUENCY") || {
      echo "[$(date -Iseconds)] invalid REVIEW_FREQUENCY=$REVIEW_FREQUENCY, skipping tick" >&2
      exit 0
    }
    if [[ -f "$LAST_RUN_FILE" ]]; then
      local last_epoch elapsed
      last_epoch=$(cat "$LAST_RUN_FILE" 2>/dev/null || echo 0)
      elapsed=$(( $(date +%s) - last_epoch ))
      if [[ "$elapsed" -lt "$freq_seconds" ]]; then
        echo "[$(date -Iseconds)] frequency gate: ${elapsed}s since last run, below ${freq_seconds}s threshold ($REVIEW_FREQUENCY) — skipping tick (use --force to override)"
        exit 0
      fi
    fi
  fi
  mkdir -p "$(dirname "$LAST_RUN_FILE")"
  date +%s > "$LAST_RUN_FILE"

  # Expire abandoned "[in-flight]" placeholders before filtering. The PID lock is
  # held here, so any surviving placeholder is orphaned from a dead run; filter
  # has not run yet (FILTER_SURVIVORS empty, no in-flight written this tick), so
  # this only ever prunes prior-run entries. Lets a crash-stranded PR re-surface.
  local _inflight_ttl; _inflight_ttl=$(duration_to_seconds "$INFLIGHT_TTL") || _inflight_ttl=3600
  prune_inflight_holds "$LEDGER_FILE" "$(date +%s)" "$_inflight_ttl" \
    || echo "[$(date -Iseconds)] in-flight prune failed (non-fatal)"

  # Phase 1 in bash: only invoke Claude when ≥1 PR survives all filters.
  # filter_prs populates FILTER_SURVIVORS and prints skip reasons to stdout.
  # Domain gate input: derive the owned-repo set once per tick. Any failure
  # arm refuses EVERY PR (fail closed) and says which arm fired — a muted loop
  # must never be indistinguishable from an empty queue.
  OWNED_GATE_FAILED=0
  resolve_owned_csv
  # Capture the reason via a redirect, NOT `$(derive_owned_repos)`: a command
  # substitution forks a subshell, so the OWNED_REPOS it builds would be
  # discarded and every repo would look unowned — a silent full mute.
  local owned_out
  owned_out=$(mktemp)
  if ! derive_owned_repos > "$owned_out"; then
    echo "[$(date -Iseconds)] ERROR: domain gate unavailable — $(cat "$owned_out")"
    OWNED_GATE_FAILED=1
  fi
  rm -f "$owned_out"

  if ! filter_prs; then
    echo "[$(date -Iseconds)] filter failed, skipping tick"
    exit 0
  fi

  if [[ ${#FILTER_SURVIVORS[@]} -eq 0 ]]; then
    echo "[$(date -Iseconds)] no PRs survived filters, skipping claude invocation"
    echo "[$(date -Iseconds)] poll done"
    exit 0
  fi

  # Pre-write an "[in-flight]" ledger entry per survivor BEFORE invoking claude.
  # The skill's HOLD path overwrites with the real entry (same key); POST/APPROVE
  # deletes it on success. If claude crashes mid-review (rate limit, etc.) the
  # placeholder persists, so the next tick's filter step 7 skips this exact
  # (PR, commit) instead of burning another retry. User runs
  # `pr-review-poller clear-hold <pr>` to force a re-review.
  local LEDGER="$LEDGER_FILE"
  mkdir -p "$(dirname "$LEDGER")"
  [[ -f "$LEDGER" ]] || echo '{}' > "$LEDGER"
  local _now; _now=$(date -Iseconds)
  local _pr_urls=()
  for survivor in "${FILTER_SURVIVORS[@]}"; do
    # See build_review_specs: `IFS=$'\t' read` collapses a middle empty field
    # (my_last_oid, e.g. first review) and shifts url into it — split by
    # parameter expansion instead.
    local _rest="$survivor"
    _o="${_rest%%$'\t'*}";    _rest="${_rest#*$'\t'}"
    _r="${_rest%%$'\t'*}";    _rest="${_rest#*$'\t'}"
    _n="${_rest%%$'\t'*}";    _rest="${_rest#*$'\t'}"
    _head="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
    _ref="${_rest%%$'\t'*}";  _rest="${_rest#*$'\t'}"
    _since="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
    _url="$_rest"
    _pr_urls+=("$_url")
    local _tmp; _tmp=$(mktemp)
    jq --arg key "$_o/$_r#$_n" \
       --arg commit "$_head" \
       --arg now "$_now" \
       --arg url "$_url" \
       '.[$key] = {commit: $commit, held_at: $now, reason: "[in-flight] auto-claimed before review", pr_url: $url}' \
       "$LEDGER" > "$_tmp" && mv "$_tmp" "$LEDGER"
  done

  # Run the reviewers HERE, in the poller's own bash, before any claude session
  # exists. History: the skill used to launch pr-review-run-all from inside the
  # headless claude session as a foreground Bash tool call; the harness force-
  # moves any foreground call to background at its 600s tool ceiling, print mode
  # then ends the session at end of turn, and the exit kills the reviewer
  # process group (189 empty invocations, 2026-07). Reviews run 10-30m under
  # pr-review-run's watchdog; only launchd bash can wait that long.
  export PR_REVIEW_RESULT_DIR="${PR_REVIEW_RESULT_DIR:-/tmp/pr-review}"
  mkdir -p "$PR_REVIEW_RESULT_DIR"
  for survivor in "${FILTER_SURVIVORS[@]}"; do
    IFS=$'\t' read -r _o _r _n _rest <<<"$survivor"
    rm -f "$PR_REVIEW_RESULT_DIR/$_n.md"
  done

  local TICK_START; TICK_START=$(date +%s)
  echo "[$(date -Iseconds)] launching ${#FILTER_SURVIVORS[@]} reviewer(s) via $RUN_ALL_SCRIPT"
  if ! build_review_specs "${FILTER_SURVIVORS[@]}" | "$RUN_ALL_SCRIPT"; then
    echo "[$(date -Iseconds)] poll FAILED — pr-review-run-all exited nonzero; ${#FILTER_SURVIVORS[@]} PR(s) remain in-flight, TTL re-queues in $INFLIGHT_TTL, or 'pr-review-poller clear-hold' to retry now"
    cleanup_dispatched "${FILTER_SURVIVORS[@]}"
    exit 1
  fi

  # Triage only: the reviewers already ran, so the claude session is short and
  # never holds a long foreground call. Model pinned: reviews post PUBLIC PR
  # comments; effort medium is plenty for rule-driven triage.
  SLASH="$SLASH --reviews-pre-run"
  CLAUDE_FLAGS=(--model claude-opus-5 --effort medium)
  # VERIFY: no MCP servers at all — harness-enforced, so mcp github/slack write
  # tools do not exist in the triage session (layer 1 of the write block).
  if [[ "$VERIFY" == "1" ]]; then
    CLAUDE_FLAGS+=(--strict-mcp-config --mcp-config '{"mcpServers":{}}')
  fi
  echo "[$(date -Iseconds)] invoking claude (${CLAUDE_FLAGS[*]}) for triage of ${#_pr_urls[@]} PR(s): $SLASH ${_pr_urls[*]}"
  local rc=0
  "$CLAUDE" "${CLAUDE_FLAGS[@]}" -p "$SLASH ${_pr_urls[*]}" || rc=$?

  # Assert BEFORE cleanup (it reads result files), clean up BEFORE any exit
  # (spec-review F2: cleanup sequenced after exit 1 is dead code on exactly the
  # failing ticks — today's worktree leak). In --reviews-pre-run mode the skill
  # skips its own Cleanup section; the poller owns worktrees and result files.
  local missing=0
  assert_findings_fresh "$TICK_START" "${FILTER_SURVIVORS[@]}" || missing=$?

  cleanup_dispatched "${FILTER_SURVIVORS[@]}"

  # VERIFY: surface every blocked write attempt. Attempts are EXPECTED here —
  # a triage that decides APPROVE will try and be denied; the findings log
  # records the intended action. Blocked attempts do not fail the tick; the
  # findings assertion above is the pass/fail authority.
  if [[ "$VERIFY" == "1" && -s "$VERIFY_GUARD_LOG" ]]; then
    echo "[$(date -Iseconds)] verify mode: $(grep -c '^BLOCKED' "$VERIFY_GUARD_LOG") GitHub write attempt(s) BLOCKED this tick:"
    sed 's/^/  /' "$VERIFY_GUARD_LOG"
  fi

  if [[ $rc -ne 0 ]]; then
    echo "[$(date -Iseconds)] poll FAILED — claude triage exited rc=$rc; ${#_pr_urls[@]} PR(s) remain in-flight; TTL re-queues in $INFLIGHT_TTL, or 'pr-review-poller clear-hold' to retry now"
    exit "$rc"
  fi
  if [[ "$missing" -gt 0 ]]; then
    echo "[$(date -Iseconds)] poll FAILED — $missing/${#FILTER_SURVIVORS[@]} findings log(s) missing or stale after triage; PR(s) remain in-flight (TTL re-queues in $INFLIGHT_TTL)"
    exit 1
  fi
  echo "[$(date -Iseconds)] poll done"
}

cmd_logs() {
  if [[ ! -f "$STDOUT_LOG" ]]; then
    echo "no log yet at $STDOUT_LOG" >&2
    exit 1
  fi
  exec tail -F "$@" "$STDOUT_LOG"
}

cmd_config() {
  load_config
  if [[ -f "$CONFIG_FILE" ]]; then
    echo "# $CONFIG_FILE"
    cat "$CONFIG_FILE"
  else
    echo "no config file at $CONFIG_FILE (run install.sh)" >&2
    exit 1
  fi
}

# Locate or list the per-PR findings logs written by kezoo-review-prs.
# Layout: $FINDINGS_DIR/<owner>/<repo>/<number>.log
cmd_findings() {
  if [[ ! -d "$FINDINGS_DIR" ]]; then
    echo "no findings yet at $FINDINGS_DIR" >&2
    exit 1
  fi

  local arg="${1:-}"
  if [[ -z "$arg" ]]; then
    # mtime-sorted, most recent first; cap at 20 so it stays readable
    find "$FINDINGS_DIR" -name '*.log' -type f -print0 \
      | xargs -0 ls -t 2>/dev/null \
      | head -20
    return
  fi

  local file=""
  if [[ "$arg" =~ github\.com/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
    file="$FINDINGS_DIR/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/${BASH_REMATCH[3]}.log"
  elif [[ "$arg" =~ ^[0-9]+$ ]]; then
    # Bare number — find any matching file. Multiple matches across orgs/repos
    # is ambiguous; fail with hints rather than guessing.
    local matches=()
    while IFS= read -r m; do matches+=("$m"); done < <(find "$FINDINGS_DIR" -name "$arg.log" -type f)
    if [[ ${#matches[@]} -eq 0 ]]; then
      echo "no findings log for PR #$arg" >&2; exit 1
    elif [[ ${#matches[@]} -gt 1 ]]; then
      echo "multiple matches for PR #$arg — pass the full URL to disambiguate:" >&2
      printf '  %s\n' "${matches[@]}" >&2
      exit 1
    fi
    file="${matches[0]}"
  else
    echo "expected a GitHub PR URL or bare number: $arg" >&2
    exit 2
  fi

  if [[ ! -f "$file" ]]; then
    echo "no findings log at $file" >&2; exit 1
  fi
  cat "$file"
}

# Remove a PR's held-ledger entry so the next tick re-reviews it. Accepts a
# full GitHub PR URL or a bare number (number must be unique across repos).
cmd_clear_hold() {
  local arg="${1:-}"
  if [[ -z "$arg" ]]; then
    echo "usage: pr-review-poller clear-hold <pr-url-or-number>" >&2; exit 2
  fi
  local LEDGER="$LEDGER_FILE"
  if [[ ! -f "$LEDGER" ]]; then
    echo "no ledger at $LEDGER" >&2; exit 1
  fi

  local key=""
  if [[ "$arg" =~ github\.com/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
    key="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}#${BASH_REMATCH[3]}"
  elif [[ "$arg" =~ ^[0-9]+$ ]]; then
    local matches=()
    while IFS= read -r m; do matches+=("$m"); done \
      < <(jq -r --arg n "$arg" 'keys[] | select(endswith("#" + $n))' "$LEDGER")
    if [[ ${#matches[@]} -eq 0 ]]; then
      echo "no held entry for PR #$arg" >&2; exit 1
    elif [[ ${#matches[@]} -gt 1 ]]; then
      echo "multiple matches for PR #$arg — pass the full URL to disambiguate:" >&2
      printf '  %s\n' "${matches[@]}" >&2
      exit 1
    fi
    key="${matches[0]}"
  else
    echo "expected GitHub PR URL or bare number: $arg" >&2; exit 2
  fi

  local before
  before=$(jq -r --arg key "$key" '.[$key] // empty' "$LEDGER")
  if [[ -z "$before" ]]; then
    echo "no held entry for $key" >&2; exit 1
  fi

  local tmp; tmp=$(mktemp)
  jq --arg key "$key" 'del(.[$key])' "$LEDGER" > "$tmp" && mv "$tmp" "$LEDGER"
  echo "cleared $key"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  SUB="${1:-status}"
  [[ $# -gt 0 ]] && shift

  case "$SUB" in
    status)     cmd_status     "$@" ;;
    start)      cmd_start      "$@" ;;
    stop)       cmd_stop       "$@" ;;
    run)        cmd_run        "$@" ;;
    logs)       cmd_logs       "$@" ;;
    findings)   cmd_findings   "$@" ;;
    clear-hold) cmd_clear_hold "$@" ;;
    prune)      cmd_prune      "$@" ;;
    config)     cmd_config     "$@" ;;
    help|-h|--help) cmd_help ;;
    *) echo "unknown subcommand: $SUB" >&2; cmd_help; exit 2 ;;
  esac
fi
